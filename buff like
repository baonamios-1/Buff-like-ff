<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Buff Like - Free Fire VIP</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #0f1115;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .card {
            background-color: #1a1d24;
            border: 2px solid #2d323e;
            border-radius: 20px;
            width: 100%;
            max-width: 450px;
            padding: 25px 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .badge-header {
            display: inline-flex;
            align-items: center;
            background-color: #10b981;
            color: #000;
            font-weight: bold;
            font-size: 14px;
            padding: 8px 16px;
            border-radius: 20px;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .title {
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 1px;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .divider {
            height: 1px;
            background-color: #2d323e;
            margin-bottom: 25px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 15px;
            color: #a0aec0;
            margin-bottom: 10px;
        }

        .form-input {
            width: 100%;
            background-color: #222630;
            border: 1px solid #323846;
            border-radius: 12px;
            padding: 16px;
            color: #ffffff;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s;
        }

        .form-input:focus {
            border-color: #3b82f6;
        }

        .btn {
            width: 100%;
            padding: 16px;
            border: none;
            border-radius: 12px;
            font-size: 18px;
            font-weight: 800;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 20px;
            transition: opacity 0.2s, transform 0.1s;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-yellow {
            background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
            color: #000000;
        }

        .btn-blue {
            background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
        }

        .btn-green {
            background: linear-gradient(180deg, #10b981 0%, #059669 100%);
            color: #ffffff;
        }

        .status-box {
            background-color: #111318;
            border: 1px dashed #374151;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
            color: #9ca3af;
            word-break: break-all;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-content {
            background-color: #1a1d24;
            border: 1px solid #374151;
            padding: 25px;
            border-radius: 16px;
            max-width: 400px;
            width: 100%;
            text-align: center;
        }

        .modal-title {
            font-size: 20px;
            margin-bottom: 15px;
            color: #10b981;
        }

        .modal-body {
            font-size: 16px;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .close-btn {
            background-color: #374151;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
